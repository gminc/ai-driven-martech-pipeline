# Google Cloud 專案
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BIGQUERY_LOCATION=US
BIGQUERY_DATASET_ID=martech_dw

# Google Gen AI SDK（google-genai）以 Agent Platform（原 Vertex AI）模式呼叫 Gemini
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# 模型分級（2026-10 基準，gemini-3.6-flash 2026-11-19 停用，改用官方建議的 gemini-3.8-flash）
# 各篇的 run.sh、agent/ 的程式與 scripts/deploy_assistant.sh 讀的是 GEMINI_MODEL_FLASH 這個環境變數，
# 沒設就用預設值 gemini-3.8-flash；要換模型就 export GEMINI_MODEL_FLASH=模型名稱 再執行，
# 單價不同的模型要先在 monitoring/price.sql 與 agent/tools.py 的 PRICES 補上單價
# GEMINI_MODEL_LITE 只有 agent/tools.py（Day 24 的評分模型預設值）讀，其他篇仍寫在 SQL 裡
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
