# Google Cloud 專案
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BIGQUERY_LOCATION=US
BIGQUERY_DATASET_ID=martech_dw

# Google Gen AI SDK（google-genai）以 Agent Platform（原 Vertex AI）模式呼叫 Gemini
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# 模型分級（2026-09 基準）
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FLASH=gemini-3.6-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
